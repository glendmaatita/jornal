{
  "name": "jornal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "vite",
    "icons": "bun scripts/generate-icons.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "bun run server.ts",
    "test": "bun test --path-ignore-patterns='**/*.integration.test.ts'",
    "test:tax:integration": "bun scripts/verify-tax-reminders.ts",
    "test:tax:e2e": "playwright test e2e/tax-reminders.e2e.ts",
    "test:invoice:integration": "RUN_POCKETBASE_INTEGRATION=1 bun test backend/pocketbase/tests/invoice_api.integration.test.ts",
    "test:invoice:renderer": "bun scripts/verify-invoice-renderer.ts",
    "test:invoice:e2e": "playwright test e2e/invoices.e2e.ts",
    "test:invoice:visual": "bun run test:invoice:renderer",
    "test:team:integration": "bun scripts/verify-team-invitations.ts",
    "test:team:email": "bun scripts/verify-team-invitations.ts",
    "test:team:e2e": "playwright test e2e/team-invitation.e2e.ts",
    "benchmark:document-ai": "bun scripts/benchmark-document-ai.ts",
    "benchmark:invoice-scale": "bun scripts/benchmark-invoice-scale.ts",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tiptap/extension-placeholder": "^3.31.0",
    "@tiptap/react": "^3.31.0",
    "@tiptap/starter-kit": "^3.31.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.39.0",
    "pocketbase": "^0.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  }
}
