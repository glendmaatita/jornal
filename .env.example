# Same-origin path proxied to PocketBase by server.ts
VITE_POCKETBASE_URL=/pb
VITE_TAX_COMPLIANCE_ENABLED=true
JORNAL_TAX_COMPLIANCE_ENABLED=true
JORNAL_TAX_EMAIL_ENABLED=false

# Build-time UI gate for creating additional companies. Existing companies
# remain readable/switchable so a rollback never merges their ledgers.
VITE_MULTI_COMPANY_ENABLED=true

# Runtime backend gate. Set false during a rollout pause; initial onboarding
# still works, while creation of company ke-2 dan seterusnya returns 403.
JORNAL_MULTI_COMPANY_ENABLED=true

# Google OAuth2 client, used by the PocketBase migration to enable the
# "Masuk dengan Google" provider (see deployment.yaml for the required
# Authorized JavaScript origin / redirect URI in Google Cloud Console).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
