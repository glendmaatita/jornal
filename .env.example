# Same-origin path proxied to PocketBase by server.ts
VITE_POCKETBASE_URL=/pb
VITE_TAX_COMPLIANCE_ENABLED=true
JORNAL_TAX_COMPLIANCE_ENABLED=true
JORNAL_TAX_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH_METHOD=PLAIN
SMTP_TLS=false
SMTP_LOCAL_NAME=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Jornal

# Build-time UI gate for creating additional companies. Existing companies
# remain readable/switchable so a rollback never merges their ledgers.
VITE_MULTI_COMPANY_ENABLED=true

# Runtime backend gate. Set false during a rollout pause; initial onboarding
# still works, while creation of company ke-2 dan seterusnya returns 403.
JORNAL_MULTI_COMPANY_ENABLED=true

# Invoice export renderer and background reminders.
JORNAL_INVOICE_EXPORT_ENABLED=true
JORNAL_INVOICE_REMINDERS_ENABLED=true
INVOICE_RENDERER_URL=http://invoice-renderer:3100
INVOICE_RENDERER_SECRET=

# Private document capture / OpenRouter. Keep AI disabled until the selected
# model/provider passes the documented benchmark; manual inbox stays usable.
VITE_DOCUMENT_CAPTURE_ENABLED=true
JORNAL_AI_CAPTURE_ENABLED=false
OPENROUTER_API_KEY=
JORNAL_AI_MODEL_PRIMARY=
JORNAL_AI_MODEL_FALLBACK=
JORNAL_AI_ALLOWED_PROVIDERS=
JORNAL_AI_DAILY_SCAN_LIMIT=20
JORNAL_AI_MONTHLY_BUDGET_USD=25

# Push delivery. Generate VAPID keys with `bunx web-push generate-vapid-keys`.
JORNAL_PUSH_ENABLED=false
JORNAL_PUSH_VAPID_PUBLIC_KEY=
JORNAL_PUSH_VAPID_PRIVATE_KEY=
JORNAL_PUSH_VAPID_SUBJECT=mailto:admin@dropify.id
JORNAL_PUSH_WORKER_SECRET=

# Google OAuth2 client, used by the PocketBase migration to enable the
# "Masuk dengan Google" provider (see deployment.yaml for the required
# Authorized JavaScript origin / redirect URI in Google Cloud Console).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
